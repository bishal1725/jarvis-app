<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bishal.jarvis">

    <!-- মাইক্ৰ'ফোন আৰু অবিৰত ভয়েচ ইনপুট -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- ইন্টাৰনেট আৰু জেমিনি এআই সংযোগ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ফোন কল আৰু যোগাযোগ নিয়ন্ত্ৰণ -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- কেমেৰা আৰু ফ্লেশ্বলাইট (টৰ্চ) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.flash" />

    <!-- বেটাৰী আৰু পাৱাৰ নিয়ন্ত্ৰণ -->
    <uses-permission android:name="android.permission.BATTERY_STATS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- স্থায়ী বেকগ্ৰাউণ্ড ছাৰ্ভিচ (এণ্ড্ৰইডে কেতিয়াও কিল নকৰিবলৈ) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:label="JARVIS"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".JarvisBackgroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

    </application>
</manifest>
